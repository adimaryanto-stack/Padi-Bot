{
  "expo": {
    "name": "PadiBot",
    "slug": "padi-bot",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "padibot",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#7CB342"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.padibot.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "PadiBot membutuhkan akses Bluetooth untuk terhubung ke mesin tanam Arduino.",
        "NSBluetoothPeripheralUsageDescription": "PadiBot membutuhkan akses Bluetooth untuk terhubung ke mesin tanam Arduino.",
        "NSLocationWhenInUseUsageDescription": "PadiBot membutuhkan lokasi GPS untuk pemetaan sawah dan navigasi mesin."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#7CB342"
      },
      "package": "com.padibot.app",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "minSdkVersion": 26
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "PadiBot membutuhkan lokasi GPS untuk pemetaan sawah dan navigasi mesin."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c6315e74-0c8b-4519-b87d-231ad3a7c22f"
      }
    }
  }
}
